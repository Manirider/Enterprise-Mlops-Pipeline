# ============================================================
# Enterprise MLOps Pipeline — Environment Variables
# ============================================================
# Copy this file to .env and populate with real values.
# NEVER commit .env to version control.
#
# Usage:
#   cp .env.example .env
#   # Edit .env with your values
#   docker-compose up --build
# ============================================================

# ── Python Environment ─────────────────────────────────────
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1
PYTHONPATH=/app

# ── DVC Analytics (disable telemetry) ─────────────────────
DVC_NO_ANALYTICS=true

# ── Logging ────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Optional: DVC Remote Storage ──────────────────────────
# Uncomment to configure cloud artifact storage
# DVC_REMOTE_URL=s3://your-bucket/dvc-artifacts
# AWS_ACCESS_KEY_ID=your-key-id
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_DEFAULT_REGION=us-east-1

# ── Optional: MLflow Tracking ──────────────────────────────
# MLFLOW_TRACKING_URI=http://localhost:5000
# MLFLOW_EXPERIMENT_NAME=enterprise-mlops-pipeline

# ── Optional: Weights & Biases ─────────────────────────────
# WANDB_API_KEY=your-wandb-key
# WANDB_PROJECT=enterprise-mlops-pipeline
